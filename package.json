{
  "name": "narco-web",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c magenta,cyan \"npm:dev -w server\" \"npm:dev -w client\"",
    "dev:https": "concurrently -k -n server,client -c magenta,cyan \"npm:dev -w server\" \"npm:dev:https -w client\"",
    "build": "npm run build -w client",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "npm run typecheck -w shared -w server -w client",
    "format": "prettier --write .",
    "icons": "node scripts/make-icons.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "26.6.5",
    "concurrently": "10.0.6",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "4.1.11"
  }
}
