{
  "dialogues": [
    {
      "id": "banker",
      "start": [
        {
          "node": "already_open",
          "requires": ["account"]
        },
        {
          "node": "no_pact",
          "requires": ["no_pact"]
        },
        {
          "node": "hello"
        }
      ],
      "nodes": [
        {
          "id": "hello",
          "speaker": "M. Lenoir",
          "text": "Bonjour. Que puis-je faire pour vous ?",
          "choices": [
            {
              "id": "ask_account",
              "label": "Je voudrais ouvrir un compte.",
              "next": "references",
              "requires": ["no_account"]
            },
            {
              "id": "nothing",
              "label": "Rien, merci.",
              "next": null
            }
          ]
        },
        {
          "id": "references",
          "speaker": "M. Lenoir",
          "text": "Bien sûr. Vous avez des références ?",
          "choices": [
            {
              "id": "jefe",
              "label": "Je viens de la part d'El Jefe.",
              "next": "offer",
              "requires": ["pact"]
            },
            {
              "id": "never_mind",
              "label": "Finalement, non.",
              "next": null
            }
          ]
        },
        {
          "id": "offer",
          "speaker": "M. Lenoir",
          "text": "Ah. El Jefe m'a dit que grâce à ce compte, je peux faire blanchir votre argent. Je prends {fee} % de la somme sale, versée en propre sur votre compte. Acceptez-vous ?",
          "choices": [
            {
              "id": "accept",
              "label": "Accepter",
              "next": "welcome",
              "requires": ["no_account"],
              "action": "open_account"
            },
            {
              "id": "refuse",
              "label": "Refuser",
              "next": "refused"
            }
          ]
        },
        {
          "id": "welcome",
          "speaker": "M. Lenoir",
          "text": "Parfait. Bienvenue chez nous. Les guichets sont à votre service.",
          "choices": [
            {
              "id": "end",
              "label": "Merci.",
              "next": null
            }
          ]
        },
        {
          "id": "refused",
          "speaker": "M. Lenoir",
          "text": "Ma proposition tient toujours. Si vous changez d'avis, n'hésitez pas.",
          "choices": [
            {
              "id": "end",
              "label": "Au revoir.",
              "next": null
            }
          ]
        },
        {
          "id": "already_open",
          "speaker": "M. Lenoir",
          "text": "Votre compte est ouvert. Les guichets sont à votre service.",
          "choices": [
            {
              "id": "end",
              "label": "Merci.",
              "next": null
            }
          ]
        },
        {
          "id": "no_pact",
          "speaker": "M. Lenoir",
          "text": "Je ne travaille qu'avec les amis d'El Jefe. Allez le voir.",
          "choices": [
            {
              "id": "end",
              "label": "J'y vais.",
              "next": null
            }
          ]
        }
      ]
    },
    {
      "id": "el_jefe",
      "start": [
        {
          "node": "reminder",
          "requires": ["pact"]
        },
        {
          "node": "welcome"
        }
      ],
      "nodes": [
        {
          "id": "welcome",
          "speaker": "El Jefe",
          "text": "Entre, entre. Tu as la tête de quelqu'un qui n'a plus rien à perdre : c'est mon profil préféré. Tu veux bosser pour moi ?",
          "choices": [
            {
              "id": "accept",
              "label": "Accepter",
              "next": "deal",
              "requires": ["no_pact"],
              "action": "accept_pact"
            },
            {
              "id": "refuse",
              "label": "Refuser",
              "next": "refused"
            }
          ]
        },
        {
          "id": "deal",
          "speaker": "El Jefe",
          "text": "Bienvenue dans la famille. Voilà {pactSeeds} graines : plante, arrose, vends. Et si tu me voles, on t'enterre avec. Tu peux dire à M. Lenoir, à la banque, que tu viens de ma part.",
          "choices": [
            {
              "id": "end",
              "label": "Compris, patron.",
              "next": null
            }
          ]
        },
        {
          "id": "refused",
          "speaker": "El Jefe",
          "text": "La porte reste ouverte. Pas longtemps.",
          "choices": [
            {
              "id": "end",
              "label": "Au revoir.",
              "next": null
            }
          ]
        },
        {
          "id": "reminder",
          "speaker": "El Jefe",
          "text": "Encore toi ? Les graines ne poussent pas pendant que tu me regardes. Au travail, et passe voir M. Lenoir à la banque.",
          "choices": [
            {
              "id": "end",
              "label": "J'y retourne.",
              "next": null
            }
          ]
        }
      ]
    }
  ]
}
